{
  "name": "aquaculture-knowledge-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "preview:prototype": "python -m http.server 8877 --bind 127.0.0.1 --directory prototype/v1"
  },
  "private": true,
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.1"
    }
  }
